{
  "mcpServers": {
    "database": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/mcp-run.sh",
      "args": ["node", "${CLAUDE_PLUGIN_ROOT}/mcps/database-mcp-server/dist/index.js"],
      "env": {
        "NODE_PATH": "${CLAUDE_PLUGIN_ROOT}/mcps/database-mcp-server/node_modules"
      }
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "render": {
      "type": "http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${RENDER_API_KEY}"
      }
    },
    "inngest": {
      "type": "http",
      "url": "http://localhost:8288/mcp"
    },
    "supabase": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/mcp-run.sh",
      "args": ["npx", "-y", "@supabase/mcp-server-supabase@latest"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "sentry": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/mcp-run.sh",
      "args": ["bash", "-c", "exec npx -y @sentry/mcp-server@latest --access-token=\"$SENTRY_AUTH_TOKEN\" --organization-slug=\"$SENTRY_ORG\""]
    },
    "stripe": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/mcp-run.sh",
      "args": ["npx", "-y", "@stripe/mcp"]
    },
    "aws": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/mcp-run.sh",
      "args": ["uvx", "awslabs.aws-api-mcp-server@latest"],
      "env": {
        "READ_OPERATIONS_ONLY": "true",
        "AWS_API_MCP_TELEMETRY": "false"
      }
    },
    "doppler": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/mcp-run.sh",
      "args": ["npx", "-y", "@dopplerhq/mcp-server"]
    },
    "context7": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/mcp-run.sh",
      "args": ["npx", "-y", "@upstash/context7-mcp@latest"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/mcp-run.sh",
      "args": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  }
}
