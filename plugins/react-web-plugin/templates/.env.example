# Generated from Doppler in real projects — this file documents the surface only.
# NEXT_PUBLIC_ vars are inlined into the browser bundle at BUILD time; everything
# else is server-only and must never gain the prefix.

# Environment tag (dev / stg / prd) — Sentry environment, feature gating
NEXT_PUBLIC_ENV=dev

# Postgres (server-only) — any provider: RDS, Neon, Vercel Postgres, Supabase.
# Also used by the plugin's database MCP server (with optional DB_SCHEMA).
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Supabase — ONLY if using Supabase for auth/database; delete this block otherwise
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — RLS bypass; webhooks and admin tasks only
SUPABASE_SERVICE_ROLE_KEY=
# Used by `yarn generate:db-types`
SUPABASE_PROJECT_REF=

# AWS S3 file storage (server-only; scope the IAM user to this bucket)
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally; from the dashboard webhook endpoint in stg/prd
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry (DSN is client-safe; auth token is build-time only)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
